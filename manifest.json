{
    "name": "__MSG_extensionName__",
    "version": "1.0.1",
    "key": "",
    "manifest_version": 3,
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "icons": {
        "16": "images/kramden-16.png",
