{
    "name": "__MSG_extensionName__",
    "version": "0.0.1",
    "manifest_version": 3,
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "permissions": [
        "activeTab",
        "identity",
        "storage"
    ],
    "host_permissions": [
        "https://mail.google.com/*"
    ],
    "oauth2": {
        "client_id": "1020910266604-f9cgs0r7rdlc4dl75dsblbs4ktiv2hfr.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/gmail.readonly"
        ]
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content-scripts/content.js"
            ]
        }
    ]
}