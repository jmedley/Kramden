{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "description": "The category label for the job section"
      },
      "jobs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "The job title"
            },
            "company": {
              "type": "string",
              "description": "The company name"
            },
            "location": {
              "type": "string",
              "description": "The job location"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The URL to the job posting"
            }
          },
          "required": [
            "title",
            "company",
            "location",
            "url"
          ]
        },
        "description": "Array of job objects in this section"
      }
    },
    "required": [
      "label",
      "jobs"
    ]
  },
  "description": "Schema for job search report sections"
}